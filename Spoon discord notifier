"""
스푼 방송 시작 -> 디스코드 @everyone 알림

구조
  1) 일정 간격으로 DJS 목록의 각 DJ가 지금 방송 중인지 확인 (check_spoon_live)
  2) 새로 방송을 켰으면(이전엔 없던 live_id) 디스코드 웹훅으로 @everyone + 링크 전송
     (DJ별로 상태를 따로 기억하므로 여러 명이 동시에 켜도 각각 알림)

표준 라이브러리만 사용하므로 설치할 패키지 없음.
실행: python spoon_discord_notifier.py
"""
import json
import time
import urllib.request

# ===================== 설정 =====================
import os
DISCORD_WEBHOOK_URL = os.environ["DISCORD_WEBHOOK_URL"]
# 감시할 DJ 목록: {스푼 user id(숫자): "표시할 이름"}
DJS = {
    11111111: "시온",
    22222222: "도담",
    33333333: "너수니",
    44444444: "루루",
    55555555: "리브",
    66666666: "설희",
    77777777: "하찮은",
    88888888: "화월",
    99999999: "휴고",
    9018142: "둘리",
}
POLL_SECONDS = 60          # DJ가 많을수록 요청이 늘어나니 너무 짧게 하지 마세요
REQUEST_GAP_SECONDS = 1    # DJ 한 명씩 확인할 때 사이 간격 (차단 방지)
# =================================================

# DJ별로 마지막에 알린 live_id 기억: {user_id: live_id}
last_notified = {}


def check_spoon_live(user_id):
    """
    지금 방송 중이면 {"live_id": ..., "title": ...} 반환, 아니면 None.

    ※ 스푼은 공개 공식 API가 없습니다. 이 함수만 실제 스푼 요청 방식에 맞게
       채워 넣으면 나머지는 그대로 동작합니다.
       (앱/웹의 네트워크 요청을 확인해 DJ 프로필의 '현재 라이브' 정보를 주는
        주소를 찾아 연결하세요.)
    """
    raise NotImplementedError("스푼 방송 여부 확인 로직을 여기에 구현하세요")


def build_live_url(live_id):
    # 웹 라이브 주소 형식 (실제 링크가 열리는지 한 번 확인해 보세요)
    return f"https://www.spooncast.net/kr/live/{live_id}"


def send_discord(dj_name, live):
    url = build_live_url(live["live_id"])
    title = live.get("title") or ""
    content = (
        f"@everyone 🎙️ **{dj_name}** 님이 스푼 방송을 시작했어요!\n"
        f"{title}\n"
        f"지금 들으러 오세요 👉 {url}"
    )
    body = json.dumps({
        "content": content,
        # @everyone 멘션이 실제로 울리도록 허용
        "allowed_mentions": {"parse": ["everyone"]},
    }).encode("utf-8")
    req = urllib.request.Request(
        DISCORD_WEBHOOK_URL,
        data=body,
        headers={"Content-Type": "application/json", "User-Agent": "spoon-notifier"},
        method="POST",
    )
    urllib.request.urlopen(req, timeout=10).read()


def main():
    print(f"감시 시작... (DJ {len(DJS)}명)")
    while True:
        for user_id, dj_name in DJS.items():
            try:
                live = check_spoon_live(user_id)
                if live and live["live_id"] != last_notified.get(user_id):
                    send_discord(dj_name, live)
                    last_notified[user_id] = live["live_id"]
                    print(f"알림 전송: {dj_name} / {live['live_id']}")
                elif not live:
                    last_notified.pop(user_id, None)  # 방송 종료 -> 다음 방송 때 다시 알림
            except NotImplementedError:
                raise
            except Exception as e:
                print(f"오류({dj_name}):", e)  # 한 명이 실패해도 다른 DJ는 계속 확인
            time.sleep(REQUEST_GAP_SECONDS)
        time.sleep(POLL_SECONDS)


if __name__ == "__main__":
    main()
